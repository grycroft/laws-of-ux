description: Apply the Laws of UX whenever creating or editing user interface code for web or mobile
globs: ["**/*.tsx", "**/*.jsx", "**/*.vue", "**/*.svelte", "**/*.html", "**/*.blade.php", "**/*.css", "**/*.scss", "**/*.swift", "**/*.kt", "**/*.dart"]
alwaysApply: false
